{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudioScoreSchema",
  "type": "object",
  "required": ["datasetId", "totalDurationSeconds", "tempoBpm", "scaleName", "notesVocabulary", "events"],
  "properties": {
    "datasetId": { "type": "string" },
    "totalDurationSeconds": { "type": "number" },
    "tempoBpm": { "type": "number" },
    "scaleName": { "type": "string" },
    "notesVocabulary": {
      "type": "array",
      "items": { "type": "string" }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestampSeconds", "note", "frequencyHz", "velocity", "durationSeconds", "pan", "instrument", "eventType"],
        "properties": {
          "timestampSeconds": { "type": "number" },
          "note": { "type": "string" },
          "frequencyHz": { "type": "number" },
          "velocity": { "type": "number", "minimum": 0, "maximum": 1 },
          "durationSeconds": { "type": "number" },
          "pan": { "type": "number", "minimum": -1, "maximum": 1 },
          "instrument": { "type": "string" },
          "eventType": { "type": "string" }
        }
      }
    }
  }
}
